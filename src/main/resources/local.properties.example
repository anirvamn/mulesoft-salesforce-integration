# Template for local development - copy to local.properties
sf.username=YOUR_SALESFORCE_USERNAME
sf.poll.frequency.ms=20000

db.host=localhost
db.port=5432
db.name=orders_db
db.user=postgres

amount.tolerance=0.01
warehouse.dir=C:/hackathon/warehouse-out

smtp.host=sandbox.smtp.mailtrap.io
smtp.port=2525
smtp.user=YOUR_SMTP_USER

notification.from=orders@example.com
notification.fulfilmentDesk=fulfilment.desk@example.com

retry.max=3
retry.delay.ms=2000
email.retry.frequency.ms=60000
email.retry.batch.size=10

orders.api.protocol=HTTP
orders.api.host=localhost
orders.api.port=8082

ref.cache.ttl.minutes=60
# API Manager Autodiscovery ID (0 for offline/local development)
api.id=0
