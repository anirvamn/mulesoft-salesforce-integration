                            LastModifiedDate: "2026-09-14T10:00:00.000Z",
                            SystemModstamp: "2026-09-14T10:00:00.000Z",
                            Account: {
                                Name: "Zenith Textiles",
                                AccountNumber: "ACC-00129",
                                ShippingStreet: "42 MG Road",
                                ShippingCity: "Bengaluru",
                                ShippingState: "KA",
                                ShippingPostalCode: "560001",
                                ShippingCountry: "India"
                            },
                            OpportunityLineItems: [{
                                Id: "00k7f00000Line1",
                                Quantity: 10.0,
                                UnitPrice: 15000.0,
                                TotalPrice: 150000.0,
                                Product2Id: "01t7f00000Prod1",
                                Product2: { Name: "Industrial Loom X1", ProductCode: "LOOM-X1" }
