                            OpportunityContactRoles: [{
                                ContactId: "0037f00000Cont1",
                                Contact: { Name: "Rajesh Kumar", Email: "rajesh@zenith.com", Phone: "+91-9876543210" }
                            }]
                        }]]'/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['System API: next order number']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="orderNumber" value="#['ERP-2026-000070']"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['System API: create order']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="persistResponse" value="#[{ attributes: { statusCode: 201 }, payload: { orderNumber: 'ERP-2026-000070', orderStatus: 'PERSISTED' } }]"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="file:write">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="file:rename">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="salesforce:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- { success: true }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value='#[output application/java --- {
                    correlationId: "test-corr-happy",
                    source: "Salesforce_Topic",
                    enqueuedAt: "2026-09-14T10:00:00Z",
                    payload: {
                        opportunityId: "0067f00000Happy1",
                        accountId: "0017f00000Acc1",
                        lastModifiedDate: "2026-09-14T10:00:00.000Z"
                    }
                }]' mediaType="application/java"/>
            </munit:set-event>
            <flow-ref name="order-consumer-flow"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[vars.orderNumber]" expected="#['ERP-2026-000070']"/>
            <munit-tools:assert-equals actual="#[vars.newStatus]" expected="#['FILE_GENERATED']"/>
            <munit-tools:assert-equals actual="#[vars.fileOk]" expected="#[true]"/>
        </munit:validation>
    </munit:test>

