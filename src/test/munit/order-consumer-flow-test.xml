    <!-- Test 1: Amount Mismatch routes to business-error-flow with AMOUNT_MISMATCH -->
    <munit:test name="order-consumer-amount-mismatch-test">
        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:query">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Query opportunity details']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="enriched" value='#[output application/java --- [{
                            Id: "0067f00000Mismatch1",
                            Name: "Amount Mismatch Test Opp",
                            AccountId: "0017f00000Acc1",
                            StageName: "Closed Won",
                            Amount: 200000.0,
                            CloseDate: "2026-09-14",
                            OwnerId: "0057f00000Owner1",
                            Owner: { Email: "owner@test.com" },
                            Pricebook2Id: "01s7f00000Pb1",
                            ERP_Order_Number__c: null,
                            Integration_Status__c: "NOT_PROCESSED",
                            LastModifiedDate: "2026-09-14T10:00:00.000Z",
                            SystemModstamp: "2026-09-14T10:00:00.000Z",
                            Account: {
                                Name: "Acme Corp",
                                AccountNumber: "ACC-001",
                                ShippingStreet: "123 Market St",
                                ShippingCity: "Bengaluru",
                                ShippingState: "KA",
                                ShippingPostalCode: "560001",
                                ShippingCountry: "India"
                            },
                            OpportunityLineItems: [{
                                Id: "00k7f00000Line1",
                                Quantity: 10.0,
                                UnitPrice: 10000.0,
                                TotalPrice: 100000.0,
                                Product2Id: "01t7f00000Prod1",
                                Product2: { Name: "Motor A1", ProductCode: "MOT-A1" }
                            }],
                            OpportunityContactRoles: [{
                                ContactId: "0037f00000Cont1",
                                Contact: { Name: "John Doe", Email: "john@acme.com", Phone: "1234567890" }
                            }]
                        }]]'/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="salesforce:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- { success: true }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="salesforce:create">
                <munit-tools:then-return>
                    <munit-tools:payload value='#[output application/java --- { items: [{ id: "00T7f00000Task1", success: true }] }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value='#[output application/java --- {
                    correlationId: "test-corr-mismatch",
                    source: "Salesforce_Topic",
                    enqueuedAt: "2026-09-14T10:00:00Z",
                    payload: {
                        opportunityId: "0067f00000Mismatch1",
                        accountId: "0017f00000Acc1",
                        lastModifiedDate: "2026-09-14T10:00:00.000Z"
                    }
                }]' mediaType="application/java"/>
            </munit:set-event>
            <flow-ref name="order-consumer-flow"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[vars.businessErrorCode]" expected="#['AMOUNT_MISMATCH']"/>
        </munit:validation>
    </munit:test>

